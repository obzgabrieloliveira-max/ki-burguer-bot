PORT=3000

# Chave usada pela dashboard e pelo cardápio para chamar este servidor.
BOT_API_KEY=98176241Bz.
ALLOWED_ORIGIN=https://ki-pedidos.netlify.app,https://ki-cardapio.netlify.app
SITE_URL=https://ki-cardapio.netlify.app/
BOT_ENABLED=true
ALLOW_REMOTE_SHUTDOWN=false

# APOLLO GATEWAY
# Copie o endpoint completo mostrado no painel do Apollo.
APOLLO_SEND_URL=https://gateway.apollochat.app/proxy/1251756794686591/messages
# Normalmente o Apollo informa o cabeçalho junto com o endpoint.
# Valores comuns: x-api-key ou Authorization
APOLLO_AUTH_HEADER=x-api-key
# Deixe vazio para x-api-key. Use Bearer apenas se o Apollo mandar usar Authorization: Bearer CHAVE
APOLLO_AUTH_PREFIX=

# meta_compatible mantém o mesmo JSON da Cloud API.
# Troque para simple somente se o endpoint do Apollo pedir {phone,message}.
APOLLO_PAYLOAD_MODE=meta_compatible

# Opcional: proteção do webhook, somente se o painel do Apollo permitir cadastrar segredo.
APOLLO_WEBHOOK_SECRET=
APOLLO_WEBHOOK_SECRET_HEADER=x-webhook-secret

# Opcional: rota de mídia fornecida pelo Apollo. Use {id} onde entra o ID.
APOLLO_MEDIA_URL_TEMPLATE=

META_TEMPLATE_LANGUAGE=pt_BR
TEMPLATE_NOVO_SITE=novo_site_kiburguer
TEMPLATE_PEDIDO_CANCELADO=pedido_cancelado1
TEMPLATE_PEDIDO_PIX=pedido_pix1
TEMPLATE_PEDIDO_EM_PREPARO=pedido_em_preparo
TEMPLATE_PEDIDO_STATUS=pedido_status1
TEMPLATE_PEDIDO_ENTREGUE=pedido_entregue
META_TEMPLATE_HEADER_IMAGE_URL=

AUTO_REPLY_MESSAGE=Olá! 🍔 Seja bem-vindo(a) à Ki-Burguer!\n\nConfira o cardápio: https://ki-cardapio.netlify.app/
HUMAN_SUPPORT_BUTTON_TEXT=Falar com Atendente
HUMAN_SUPPORT_REPLY=Certo! Sua solicitação de atendimento foi recebida. Em breve responderemos por aqui.
